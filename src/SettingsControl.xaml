<UserControl x:Class="QSBT1Plugin.SettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" Width="900">
    <UserControl.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#E8A020"/>
            <Setter Property="Margin"     Value="0,14,0,4"/>
        </Style>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground"        Value="#DDDDDD"/>
            <Setter Property="MinWidth"          Value="130"/>
        </Style>
        <Style x:Key="Val" TargetType="TextBox">
            <Setter Property="Width"       Value="160"/>
            <Setter Property="Padding"     Value="4,2"/>
            <Setter Property="Background"  Value="#2A2A2A"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="BorderBrush" Value="#555"/>
        </Style>
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Padding"     Value="10,4"/>
            <Setter Property="Background"  Value="#333"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="BorderBrush" Value="#666"/>
            <Setter Property="Margin"      Value="0,0,8,0"/>
        </Style>
        <Style x:Key="NudgeBtn" TargetType="Button">
            <Setter Property="Width"       Value="18"/>
            <Setter Property="Height"      Value="18"/>
            <Setter Property="Padding"     Value="0"/>
            <Setter Property="FontSize"    Value="10"/>
            <Setter Property="Background"  Value="#2E2E2E"/>
            <Setter Property="Foreground"  Value="#AAAAAA"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="Cursor"      Value="Hand"/>
        </Style>
        <Style x:Key="TblHdr" TargetType="TextBlock">
            <Setter Property="Foreground"    Value="#E8A020"/>
            <Setter Property="FontWeight"    Value="SemiBold"/>
            <Setter Property="FontSize"      Value="11"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Padding"       Value="2,5"/>
        </Style>
        <Style x:Key="TblName" TargetType="TextBlock">
            <Setter Property="Foreground"        Value="#CCCCCC"/>
            <Setter Property="FontSize"          Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding"           Value="10,0,4,0"/>
        </Style>
        <Style x:Key="TblVal" TargetType="TextBlock">
            <Setter Property="Foreground"        Value="White"/>
            <Setter Property="FontSize"          Value="11"/>
            <Setter Property="TextAlignment"     Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MinWidth"          Value="38"/>
        </Style>
        <Style x:Key="InfoLbl" TargetType="TextBlock">
            <Setter Property="Foreground"        Value="#888"/>
            <Setter Property="FontSize"          Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,16">

            <!-- ══ HEADER ══════════════════════════════════════════════════════ -->
            <!-- Logo + Title side by side -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image x:Name="ImgLogo" Grid.Column="0" MaxHeight="80" MaxWidth="80"
                       Margin="0,0,16,0" VerticalAlignment="Center" Stretch="Uniform"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="nutho313 QSBT1_ControlMapper"
                               FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Qubic System QS-BT1 — SimHub Control Mapper Plugin"
                               Foreground="#999" FontSize="11" Margin="0,3,0,0"/>
                    <!-- Status line (4) right of title -->
                    <TextBlock x:Name="TxtStatus" Foreground="#88BB55" FontSize="11" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
            <Separator Background="#444"/>

            <!-- ══ NETWORK ══════════════════════════════════════════════════════ -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="Network"/>
            <!-- IP + Port on same row (3) -->
            <StackPanel Orientation="Horizontal" Margin="0,3">
                <TextBlock Style="{StaticResource Lbl}" Text="IP Address"/>
                <TextBox x:Name="TxtIp" Style="{StaticResource Val}"
                         Text="{Binding IpAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Style="{StaticResource Lbl}" Text="Port" Margin="14,0,0,0" MinWidth="36"/>
                <TextBox Style="{StaticResource Val}" Width="70"
                         Text="{Binding Port, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Style="{StaticResource Btn}" Content="Auto-detect" Margin="10,0,0,0" Tag="detect" Click="Btn_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Style="{StaticResource Lbl}" Text="QS-BT1 Web Interface"/>
                <TextBlock x:Name="TxtWebLink" Foreground="#4A9EE8" FontSize="12"
                           VerticalAlignment="Center" Cursor="Hand"
                           MouseLeftButtonUp="WebLink_Click" TextDecorations="Underline"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,4">
                <Button Style="{StaticResource Btn}" Content="Test Connection" Tag="test" Click="Btn_Click"/>
            </StackPanel>

            <Separator Background="#444" Margin="0,10,0,0"/>

            <!-- ══ PROFILE ══════════════════════════════════════════════════════ -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="Profile"/>
            <StackPanel Orientation="Horizontal" Margin="0,3">
                <TextBlock Style="{StaticResource Lbl}" Text="Activate Profile"/>
                <ComboBox x:Name="CboProfile" Width="320" Background="#2A2A2A" Foreground="White"
                          DisplayMemberPath="Display" SelectionChanged="CboProfile_SelectionChanged"/>
                <!-- Activate button now in profile section (2) -->
                <Button Style="{StaticResource Btn}" Content="Activate Profile"
                        Tag="activate" Margin="10,0,0,0" Click="Btn_Click"/>
            </StackPanel>

            <Separator Background="#444" Margin="0,12,0,0"/>

            <!-- ══ SEAT BELT TENSIONER | BASE ═══════════════════════════════════ -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="Seat Belt Tensioner | Base"/>

            <!-- Table 1: Gain / Sharpness / Deadzone -->
            <Border Background="#1A1A1A" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="4" Margin="0,2,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="46"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Grid.ColumnSpan="5" Background="#1E1A10" BorderBrush="#5A3E00" BorderThickness="0,0,0,1"/>
                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource TblHdr}" TextAlignment="Left" Padding="10,5" Text="Tune"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource TblHdr}" Text="Gain"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource TblHdr}" Text="Sharpness"/>
                    <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource TblHdr}" Text="Deadzone"/>
                    <TextBlock Grid.Row="0" Grid.Column="4" Style="{StaticResource TblHdr}" Text="On"/>
                    <!-- Braking -->
                    <Border Grid.Row="1" Grid.ColumnSpan="5" Background="#222" BorderBrush="#2E2E2E" BorderThickness="0,0,0,1"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource TblName}" Text="Braking"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4">
                        <Button Style="{StaticResource NudgeBtn}" Content="&lt;" Tag="braking|gain|-1" Click="Nudge_Click"/>
                        <TextBlock Style="{StaticResource TblVal}" Text="{Binding Braking_Gain, Mode=OneWay, StringFormat=N2}"/>
                        <Button Style="{StaticResource NudgeBtn}" Content="&gt;" Tag="braking|gain|+1" Click="Nudge_Click"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4">
                        <Button Style="{StaticResource NudgeBtn}" Content="&lt;" Tag="braking|sharpness|-1" Click="Nudge_Click"/>
                        <TextBlock Style="{StaticResource TblVal}" Text="{Binding Braking_Sharpness, Mode=OneWay, StringFormat=N2}"/>
                        <Button Style="{StaticResource NudgeBtn}" Content="&gt;" Tag="braking|sharpness|+1" Click="Nudge_Click"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4">
                        <Button Style="{StaticResource NudgeBtn}" Content="&lt;" Tag="braking|deadzone|-1" Click="Nudge_Click"/>
                        <TextBlock Style="{StaticResource TblVal}" Text="{Binding Braking_Deadzone, Mode=OneWay, StringFormat=N2}"/>
                        <Button Style="{StaticResource NudgeBtn}" Content="&gt;" Tag="braking|deadzone|+1" Click="Nudge_Click"/>
                    </StackPanel>
                    <CheckBox Grid.Row="1" Grid.Column="4" HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding Braking_Enabled, Mode=TwoWay}" Tag="braking_enabled" Checked="ChkEnabled_Changed" Unchecked="ChkEnabled_Changed"/>
                    <!-- Acceleration -->
                    <Border Grid.Row="2" Grid.ColumnSpan="5" Background="#1E1E1E" BorderBrush="#2E2E2E" BorderThickness="0,0,0,1"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource TblName}" Text="Acceleration"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4">
                        <Button Style="{StaticResource NudgeBtn}" Content="&lt;" Tag="acceleration|gain|-1" Click="Nudge_Click"/>
                        <TextBlock Style="{StaticResource TblVal}" Text="{Binding Acceleration_Gain, Mode=OneWay, StringFormat=N2}"/>
                        <Button Style="{StaticResource NudgeBtn}" Content="&gt;" Tag="acceleration|gain|+1" Click="Nudge_Click"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4">
                        <Button Style="{StaticResource NudgeBtn}" Content="&lt;" Tag="acceleration|sharpness|-1" Click="Nudge_Click"/>
                        <TextBlock Style="{StaticResource TblVal}" Text="{Binding Acceleration_Sharpness, Mode=OneWay, StringFormat=N2}"/>
                        <Button Style="{StaticResource NudgeBtn}" Content="&gt;" Tag="acceleration|sharpness|+1" Click="Nudge_Click"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4">
                        <Button Style="{StaticResource NudgeBtn}" Content="&lt;" Tag="acceleration|deadzone|-1" Click="Nudge_Click"/>
                        <TextBlock Style="{StaticResource TblVal}" Text="{Binding Acceleration_Deadzone, Mode=OneWay, StringFormat=N2}"/>
                        <Button Style="{StaticResource NudgeBtn}" Content="&gt;" Tag="acceleration|deadzone|+1" Click="Nudge_Click"/>
                    </StackPanel>
                    <CheckBox Grid.Row="2" Grid.Column="4" HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding Acceleration_Enabled, Mode=TwoWay}" Tag="acceleration_enabled" Checked="ChkEnabled_Changed" Unchecked="ChkEnabled_Changed"/>
                    <!-- Sideways -->
                    <Border Grid.Row="3" Grid.ColumnSpan="5" Background="#222" BorderBrush="#2E2E2E" BorderThickness="0,0,0,1"/>
                    <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource TblName}" Text="Sideways Accel."/>
                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4">
                        <Button Style="{StaticResource NudgeBtn}" Content="&lt;" Tag="sideways|gain|-1" Click="Nudge_Click"/>
                        <TextBlock Style="{StaticResource TblVal}" Text="{Binding Sideways_Gain, Mode=OneWay, StringFormat=N2}"/>
                        <Button Style="{StaticResource NudgeBtn}" Content="&gt;" Tag="sideways|gain|+1" Click="Nudge_Click"/>
                    </StackPanel>
                    <StackPanel Grid.Row="3" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4">
                        <Button Style="{StaticResource NudgeBtn}" Content="&lt;" Tag="sideways|sharpness|-1" Click="Nudge_Click"/>
                        <TextBlock Style="{StaticResource TblVal}" Text="{Binding Sideways_Sharpness, Mode=OneWay, StringFormat=N2}"/>
                        <Button Style="{StaticResource NudgeBtn}" Content="&gt;" Tag="sideways|sharpness|+1" Click="Nudge_Click"/>
                    </StackPanel>
                    <StackPanel Grid.Row="3" Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4">
                        <Button Style="{StaticResource NudgeBtn}" Content="&lt;" Tag="sideways|deadzone|-1" Click="Nudge_Click"/>
                        <TextBlock Style="{StaticResource TblVal}" Text="{Binding Sideways_Deadzone, Mode=OneWay, StringFormat=N2}"/>
                        <Button Style="{StaticResource NudgeBtn}" Content="&gt;" Tag="sideways|deadzone|+1" Click="Nudge_Click"/>
                    </StackPanel>
                    <CheckBox Grid.Row="3" Grid.Column="4" HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding Sideways_Enabled, Mode=TwoWay}" Tag="sideways_enabled" Checked="ChkEnabled_Changed" Unchecked="ChkEnabled_Changed"/>
                    <!-- Centrifugal -->
                    <Border Grid.Row="4" Grid.ColumnSpan="5" Background="#1E1E1E"/>
                    <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource TblName}" Text="Centrifugal Force"/>
                    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4">
                        <Button Style="{StaticResource NudgeBtn}" Content="&lt;" Tag="centrifugal|gain|-1" Click="Nudge_Click"/>
                        <TextBlock Style="{StaticResource TblVal}" Text="{Binding Centrifugal_Gain, Mode=OneWay, StringFormat=N2}"/>
                        <Button Style="{StaticResource NudgeBtn}" Content="&gt;" Tag="centrifugal|gain|+1" Click="Nudge_Click"/>
                    </StackPanel>
                    <StackPanel Grid.Row="4" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4">
                        <Button Style="{StaticResource NudgeBtn}" Content="&lt;" Tag="centrifugal|sharpness|-1" Click="Nudge_Click"/>
                        <TextBlock Style="{StaticResource TblVal}" Text="{Binding Centrifugal_Sharpness, Mode=OneWay, StringFormat=N2}"/>
                        <Button Style="{StaticResource NudgeBtn}" Content="&gt;" Tag="centrifugal|sharpness|+1" Click="Nudge_Click"/>
                    </StackPanel>
                    <StackPanel Grid.Row="4" Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4">
                        <Button Style="{StaticResource NudgeBtn}" Content="&lt;" Tag="centrifugal|deadzone|-1" Click="Nudge_Click"/>
                        <TextBlock Style="{StaticResource TblVal}" Text="{Binding Centrifugal_Deadzone, Mode=OneWay, StringFormat=N2}"/>
                        <Button Style="{StaticResource NudgeBtn}" Content="&gt;" Tag="centrifugal|deadzone|+1" Click="Nudge_Click"/>
                    </StackPanel>
                    <CheckBox Grid.Row="4" Grid.Column="4" HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding Centrifugal_Enabled, Mode=TwoWay}" Tag="centrifugal_enabled" Checked="ChkEnabled_Changed" Unchecked="ChkEnabled_Changed"/>
                </Grid>
            </Border>

            <!-- Table 2: Gain / Sharpness -->
            <Border Background="#1A1A1A" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="4" Margin="0,2,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="46"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Grid.ColumnSpan="4" Background="#1E1A10" BorderBrush="#5A3E00" BorderThickness="0,0,0,1"/>
                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource TblHdr}" TextAlignment="Left" Padding="10,5" Text="Tune"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource TblHdr}" Text="Gain"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource TblHdr}" Text="Sharpness"/>
                    <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource TblHdr}" Text="On"/>
                    <!-- Vertical G-Force -->
                    <Border Grid.Row="1" Grid.ColumnSpan="4" Background="#222" BorderBrush="#2E2E2E" BorderThickness="0,0,0,1"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource TblName}" Text="Vertical G-Force"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4">
                        <Button Style="{StaticResource NudgeBtn}" Content="&lt;" Tag="verticalg|gain|-1" Click="Nudge_Click"/>
                        <TextBlock Style="{StaticResource TblVal}" Text="{Binding VerticalG_Gain, Mode=OneWay, StringFormat=N2}"/>
                        <Button Style="{StaticResource NudgeBtn}" Content="&gt;" Tag="verticalg|gain|+1" Click="Nudge_Click"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4">
                        <Button Style="{StaticResource NudgeBtn}" Content="&lt;" Tag="verticalg|sharpness|-1" Click="Nudge_Click"/>
                        <TextBlock Style="{StaticResource TblVal}" Text="{Binding VerticalG_Sharpness, Mode=OneWay, StringFormat=N2}"/>
                        <Button Style="{StaticResource NudgeBtn}" Content="&gt;" Tag="verticalg|sharpness|+1" Click="Nudge_Click"/>
                    </StackPanel>
                    <CheckBox Grid.Row="1" Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding VerticalG_Enabled, Mode=TwoWay}" Tag="verticalg_enabled" Checked="ChkEnabled_Changed" Unchecked="ChkEnabled_Changed"/>
                    <!-- Road Harshness -->
                    <Border Grid.Row="2" Grid.ColumnSpan="4" Background="#1E1E1E"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource TblName}" Text="Road Harshness"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4">
                        <Button Style="{StaticResource NudgeBtn}" Content="&lt;" Tag="roadharshness|gain|-1" Click="Nudge_Click"/>
                        <TextBlock Style="{StaticResource TblVal}" Text="{Binding RoadHarshness_Gain, Mode=OneWay, StringFormat=N2}"/>
                        <Button Style="{StaticResource NudgeBtn}" Content="&gt;" Tag="roadharshness|gain|+1" Click="Nudge_Click"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4">
                        <Button Style="{StaticResource NudgeBtn}" Content="&lt;" Tag="roadharshness|sharpness|-1" Click="Nudge_Click"/>
                        <TextBlock Style="{StaticResource TblVal}" Text="{Binding RoadHarshness_Sharpness, Mode=OneWay, StringFormat=N2}"/>
                        <Button Style="{StaticResource NudgeBtn}" Content="&gt;" Tag="roadharshness|sharpness|+1" Click="Nudge_Click"/>
                    </StackPanel>
                    <CheckBox Grid.Row="2" Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding RoadHarshness_Enabled, Mode=TwoWay}" Tag="roadharshness_enabled" Checked="ChkEnabled_Changed" Unchecked="ChkEnabled_Changed"/>
                </Grid>
            </Border>

            <!-- Table 3: Threshold / Frequency / Intensity — Side Slip -->
            <Border Background="#1A1A1A" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="4" Margin="0,2,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="46"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Grid.ColumnSpan="5" Background="#1E1A10" BorderBrush="#5A3E00" BorderThickness="0,0,0,1"/>
                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource TblHdr}" TextAlignment="Left" Padding="10,5" Text="Tune"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource TblHdr}" Text="Threshold"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource TblHdr}" Text="Frequency"/>
                    <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource TblHdr}" Text="Intensity"/>
                    <TextBlock Grid.Row="0" Grid.Column="4" Style="{StaticResource TblHdr}" Text="On"/>
                    <Border Grid.Row="1" Grid.ColumnSpan="5" Background="#222"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource TblName}" Text="Side Slip"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4">
                        <Button Style="{StaticResource NudgeBtn}" Content="&lt;" Tag="sideslip|threshold|-1" Click="Nudge_Click"/>
                        <TextBlock Style="{StaticResource TblVal}" Text="{Binding SideSlip_Threshold, Mode=OneWay, StringFormat=N2}"/>
                        <Button Style="{StaticResource NudgeBtn}" Content="&gt;" Tag="sideslip|threshold|+1" Click="Nudge_Click"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4">
                        <Button Style="{StaticResource NudgeBtn}" Content="&lt;" Tag="sideslip|frequency|-1" Click="Nudge_Click"/>
                        <TextBlock Style="{StaticResource TblVal}" Text="{Binding SideSlip_Frequency, Mode=OneWay, StringFormat=N0}"/>
                        <Button Style="{StaticResource NudgeBtn}" Content="&gt;" Tag="sideslip|frequency|+1" Click="Nudge_Click"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4">
                        <Button Style="{StaticResource NudgeBtn}" Content="&lt;" Tag="sideslip|intensity|-1" Click="Nudge_Click"/>
                        <TextBlock Style="{StaticResource TblVal}" Text="{Binding SideSlip_Intensity, Mode=OneWay, StringFormat=N2}"/>
                        <Button Style="{StaticResource NudgeBtn}" Content="&gt;" Tag="sideslip|intensity|+1" Click="Nudge_Click"/>
                    </StackPanel>
                    <CheckBox Grid.Row="1" Grid.Column="4" HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding SideSlip_Enabled, Mode=TwoWay}" Tag="sideslip_enabled" Checked="ChkEnabled_Changed" Unchecked="ChkEnabled_Changed"/>
                </Grid>
            </Border>

            <!-- Table 4: Neutral / Maximum — Bounds -->
            <Border Background="#1A1A1A" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="4" Margin="0,2,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="46"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Grid.ColumnSpan="4" Background="#1E1A10" BorderBrush="#5A3E00" BorderThickness="0,0,0,1"/>
                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource TblHdr}" TextAlignment="Left" Padding="10,5" Text="Tune"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource TblHdr}" Text="Neutral"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource TblHdr}" Text="Maximum"/>
                    <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource TblHdr}" Text="On"/>
                    <Border Grid.Row="1" Grid.ColumnSpan="4" Background="#222"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource TblName}" Text="Bounds %"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4">
                        <Button Style="{StaticResource NudgeBtn}" Content="&lt;" Tag="bounds|neutral|-1" Click="Nudge_Click"/>
                        <TextBlock Style="{StaticResource TblVal}" Text="{Binding Bounds_Neutral, Mode=OneWay, StringFormat=N0}"/>
                        <Button Style="{StaticResource NudgeBtn}" Content="&gt;" Tag="bounds|neutral|+1" Click="Nudge_Click"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4">
                        <Button Style="{StaticResource NudgeBtn}" Content="&lt;" Tag="bounds|maximum|-1" Click="Nudge_Click"/>
                        <TextBlock Style="{StaticResource TblVal}" Text="{Binding Bounds_Maximum, Mode=OneWay, StringFormat=N0}"/>
                        <Button Style="{StaticResource NudgeBtn}" Content="&gt;" Tag="bounds|maximum|+1" Click="Nudge_Click"/>
                    </StackPanel>
                    <CheckBox Grid.Row="1" Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding Bounds_Enabled, Mode=TwoWay}" Tag="bounds_enabled" Checked="ChkEnabled_Changed" Unchecked="ChkEnabled_Changed"/>
                </Grid>
            </Border>

            <!-- Table 5: Long. / Lateral / Duration — Pre-Impact -->
            <Border Background="#1A1A1A" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="4" Margin="0,2,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="46"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
