                                <Button Style="{StaticResource NudgeBtn}" Content="&lt;" Tag="sfx_lfe|val0|-1" Click="Nudge_Click"/>
                                <TextBlock Style="{StaticResource TblVal}" Text="{Binding SFX_LFE_Val0, Mode=OneWay, StringFormat=N2}"/>
                                <Button Style="{StaticResource NudgeBtn}" Content="&gt;" Tag="sfx_lfe|val0|+1" Click="Nudge_Click"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4">
                                <Button Style="{StaticResource NudgeBtn}" Content="&lt;" Tag="sfx_lfe|val1|-1" Click="Nudge_Click"/>
                                <TextBlock Style="{StaticResource TblVal}" Text="{Binding SFX_LFE_Val1, Mode=OneWay, StringFormat=N2}"/>
                                <Button Style="{StaticResource NudgeBtn}" Content="&gt;" Tag="sfx_lfe|val1|+1" Click="Nudge_Click"/>
                            </StackPanel>
                            <CheckBox Grid.Row="1" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      IsChecked="{Binding SfxLfe_Enabled, Mode=TwoWay}"
                                      Tag="sfx_lfe_enabled" Checked="ChkEnabled_Changed" Unchecked="ChkEnabled_Changed"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- BOTTOM LEFT: Motion Primary | SFX -->
                <StackPanel Grid.Row="2" Grid.Column="0">
                    <!-- ══ MOTION PRIMARY | SFX ════════════════════════════════════════ -->
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Motion Primary | SFX"/>
                    <Border Background="#1A1A1A" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="4" Margin="0,2,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="46"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Grid.ColumnSpan="5" Background="#1E1A10" BorderBrush="#5A3E00" BorderThickness="0,0,0,1"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource TblHdr}" TextAlignment="Left" Padding="10,5" Text="Tune"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource TblHdr}" Text="Value"/>
                            <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource TblHdr}" Text="Unit"/>
                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource TblHdr}" Text="On"/>
                            <!-- Row 1: Violent Movement Threshold -->
                            <Border Grid.Row="1" Grid.ColumnSpan="5" Background="#222" BorderBrush="#2E2E2E" BorderThickness="0,0,0,1"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource TblName}" Text="Violent Mvt. Threshold"/>
                            <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4">
                                <Button Style="{StaticResource NudgeBtn}" Content="&lt;" Tag="vms|threshold|-1" Click="Nudge_Click"/>
                                <TextBlock Style="{StaticResource TblVal}" Text="{Binding VMS_Threshold, Mode=OneWay, StringFormat=N0}"/>
                                <Button Style="{StaticResource NudgeBtn}" Content="&gt;" Tag="vms|threshold|+1" Click="Nudge_Click"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource TblVal}" Text="m/s²" Foreground="#888" HorizontalAlignment="Center"/>
                            <CheckBox Grid.Row="1" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      IsChecked="{Binding Vms_Enabled, Mode=TwoWay}"
                                      Tag="vms_enabled" Checked="ChkEnabled_Changed" Unchecked="ChkEnabled_Changed"/>
                            <!-- Row 2: Violent Movement Suppression Time -->
                            <Border Grid.Row="2" Grid.ColumnSpan="5" Background="#1E1E1E"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource TblName}" Text="Suppression Time"/>
                            <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4">
                                <Button Style="{StaticResource NudgeBtn}" Content="&lt;" Tag="vms|duration|-1" Click="Nudge_Click"/>
                                <TextBlock Style="{StaticResource TblVal}" Text="{Binding VMS_Duration, Mode=OneWay, StringFormat=N2}"/>
                                <Button Style="{StaticResource NudgeBtn}" Content="&gt;" Tag="vms|duration|+1" Click="Nudge_Click"/>
                            </StackPanel>
                            <TextBlock Grid.Row="2" Grid.Column="3" Style="{StaticResource TblVal}" Text="s" Foreground="#888" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- BOTTOM RIGHT: Vehicle Parameters -->
                <StackPanel Grid.Row="2" Grid.Column="2">
                    <!-- ══ VEHICLE PARAMETERS (tuneGroup 13) ═════════════════════════ -->
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Vehicle Parameters"/>
                    <!-- Rev Limiter + Wheel Fwd Slip -->
                    <Border Background="#1A1A1A" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="4" Margin="0,2,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="46"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Grid.ColumnSpan="5" Background="#1E1A10" BorderBrush="#5A3E00" BorderThickness="0,0,0,1"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource TblHdr}" TextAlignment="Left" Padding="10,5" Text="Tune"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource TblHdr}" Text="Param 1"/>
                            <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource TblHdr}" Text="Param 2"/>
                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource TblHdr}" Text="On"/>
                            <Border Grid.Row="1" Grid.ColumnSpan="5" Background="#222" BorderBrush="#2E2E2E" BorderThickness="0,0,0,1"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center" Margin="10,4,4,4">
                                <TextBlock Style="{StaticResource TblName}" Text="Rev Limiter" Padding="0"/>
                                <TextBlock Foreground="#555" FontSize="9" Text="Max Gear  ·  Offset"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4">
                                <Button Style="{StaticResource NudgeBtn}" Content="&lt;" Tag="vp_revlimiter|maxgear|-1" Click="Nudge_Click"/>
                                <TextBlock Style="{StaticResource TblVal}" Text="{Binding VP_RevLimiter_MaxGear, Mode=OneWay, StringFormat=N1}"/>
                                <Button Style="{StaticResource NudgeBtn}" Content="&gt;" Tag="vp_revlimiter|maxgear|+1" Click="Nudge_Click"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4">
                                <Button Style="{StaticResource NudgeBtn}" Content="&lt;" Tag="vp_revlimiter|offset|-1" Click="Nudge_Click"/>
                                <TextBlock Style="{StaticResource TblVal}" Text="{Binding VP_RevLimiter_Offset, Mode=OneWay, StringFormat=N0}"/>
                                <Button Style="{StaticResource NudgeBtn}" Content="&gt;" Tag="vp_revlimiter|offset|+1" Click="Nudge_Click"/>
                            </StackPanel>
                            <CheckBox Grid.Row="1" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      IsChecked="{Binding VpRevlimiter_Enabled, Mode=TwoWay}"
                                      Tag="vp_revlimiter_enabled" Checked="ChkEnabled_Changed" Unchecked="ChkEnabled_Changed"/>
                            <Border Grid.Row="2" Grid.ColumnSpan="5" Background="#1E1E1E"/>
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center" Margin="10,4,4,4">
                                <TextBlock Style="{StaticResource TblName}" Text="Wheel Fwd Slip" Padding="0"/>
                                <TextBlock Foreground="#555" FontSize="9" Text="Front %  ·  Rear %"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4">
                                <Button Style="{StaticResource NudgeBtn}" Content="&lt;" Tag="vp_wheelfwdslip|front|-1" Click="Nudge_Click"/>
                                <TextBlock Style="{StaticResource TblVal}" Text="{Binding VP_WheelFwdSlip_Front, Mode=OneWay, StringFormat=N0}"/>
                                <Button Style="{StaticResource NudgeBtn}" Content="&gt;" Tag="vp_wheelfwdslip|front|+1" Click="Nudge_Click"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4">
                                <Button Style="{StaticResource NudgeBtn}" Content="&lt;" Tag="vp_wheelfwdslip|rear|-1" Click="Nudge_Click"/>
                                <TextBlock Style="{StaticResource TblVal}" Text="{Binding VP_WheelFwdSlip_Rear, Mode=OneWay, StringFormat=N0}"/>
                                <Button Style="{StaticResource NudgeBtn}" Content="&gt;" Tag="vp_wheelfwdslip|rear|+1" Click="Nudge_Click"/>
                            </StackPanel>
                            <CheckBox Grid.Row="2" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      IsChecked="{Binding VpWheelfwdslip_Enabled, Mode=TwoWay}"
                                      Tag="vp_wheelfwdslip_enabled" Checked="ChkEnabled_Changed" Unchecked="ChkEnabled_Changed"/>
                        </Grid>
                    </Border>
                    <!-- Wheel Slip Angle -->
                    <Border Background="#1A1A1A" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="4" Margin="0,2,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Grid.ColumnSpan="6" Background="#1E1A10" BorderBrush="#5A3E00" BorderThickness="0,0,0,1"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource TblHdr}" TextAlignment="Left" Padding="10,5" Text="Tune"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource TblHdr}" Text="Front (°)"/>
                            <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource TblHdr}" Text="Rear (°)"/>
                            <TextBlock Grid.Row="0" Grid.Column="4" Style="{StaticResource TblHdr}" Text="Escalation"/>
                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource TblHdr}" Text="On"/>
                            <Border Grid.Row="1" Grid.ColumnSpan="6" Background="#222"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource TblName}" Text="Wheel Slip Angle"/>
                            <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4">
                                <Button Style="{StaticResource NudgeBtn}" Content="&lt;" Tag="vp_slipangle|front|-1" Click="Nudge_Click"/>
                                <TextBlock Style="{StaticResource TblVal}" Text="{Binding VP_SlipAngle_Front, Mode=OneWay, StringFormat=N2}"/>
                                <Button Style="{StaticResource NudgeBtn}" Content="&gt;" Tag="vp_slipangle|front|+1" Click="Nudge_Click"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4">
                                <Button Style="{StaticResource NudgeBtn}" Content="&lt;" Tag="vp_slipangle|rear|-1" Click="Nudge_Click"/>
                                <TextBlock Style="{StaticResource TblVal}" Text="{Binding VP_SlipAngle_Rear, Mode=OneWay, StringFormat=N2}"/>
                                <Button Style="{StaticResource NudgeBtn}" Content="&gt;" Tag="vp_slipangle|rear|+1" Click="Nudge_Click"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4">
                                <Button Style="{StaticResource NudgeBtn}" Content="&lt;" Tag="vp_slipangle|escalation|-1" Click="Nudge_Click"/>
                                <TextBlock Style="{StaticResource TblVal}" Text="{Binding VP_SlipAngle_Escalation, Mode=OneWay, StringFormat=N2}"/>
                                <Button Style="{StaticResource NudgeBtn}" Content="&gt;" Tag="vp_slipangle|escalation|+1" Click="Nudge_Click"/>
                            </StackPanel>
                            <CheckBox Grid.Row="1" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      IsChecked="{Binding VpSlipangle_Enabled, Mode=TwoWay}"
                                      Tag="vp_slipangle_enabled" Checked="ChkEnabled_Changed" Unchecked="ChkEnabled_Changed"/>
                        </Grid>
                    </Border>
                    <!-- WheelBase / TurningCircle / CoGBias -->
                    <Border Background="#1A1A1A" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="4" Margin="0,2,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="46"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Grid.ColumnSpan="4" Background="#1E1A10" BorderBrush="#5A3E00" BorderThickness="0,0,0,1"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource TblHdr}" TextAlignment="Left" Padding="10,5" Text="Parameter"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource TblHdr}" Text="Value"/>
                            <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource TblHdr}" Text=""/>
                            <Border Grid.Row="1" Grid.ColumnSpan="4" Background="#222" BorderBrush="#2E2E2E" BorderThickness="0,0,0,1"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource TblName}" Text="Wheel Base (m)"/>
                            <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4">
                                <Button Style="{StaticResource NudgeBtn}" Content="&lt;" Tag="vp_wheelbase||-1" Click="Nudge_Click"/>
                                <TextBlock Style="{StaticResource TblVal}" Text="{Binding VP_WheelBase, Mode=OneWay, StringFormat=N2}"/>
                                <Button Style="{StaticResource NudgeBtn}" Content="&gt;" Tag="vp_wheelbase||+1" Click="Nudge_Click"/>
                            </StackPanel>
                            <Border Grid.Row="2" Grid.ColumnSpan="4" Background="#1E1E1E" BorderBrush="#2E2E2E" BorderThickness="0,0,0,1"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource TblName}" Text="Turning Circle (m)"/>
                            <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4">
                                <Button Style="{StaticResource NudgeBtn}" Content="&lt;" Tag="vp_turningcircle||-1" Click="Nudge_Click"/>
                                <TextBlock Style="{StaticResource TblVal}" Text="{Binding VP_TurningCircle, Mode=OneWay, StringFormat=N2}"/>
                                <Button Style="{StaticResource NudgeBtn}" Content="&gt;" Tag="vp_turningcircle||+1" Click="Nudge_Click"/>
                            </StackPanel>
                            <Border Grid.Row="3" Grid.ColumnSpan="4" Background="#222"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource TblName}" Text="CoG Bias (0=front · 1=rear)"/>
                            <StackPanel Grid.Row="3" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4">
                                <Button Style="{StaticResource NudgeBtn}" Content="&lt;" Tag="vp_cogbias||-1" Click="Nudge_Click"/>
                                <TextBlock Style="{StaticResource TblVal}" Text="{Binding VP_CoGBias, Mode=OneWay, StringFormat=N2}"/>
                                <Button Style="{StaticResource NudgeBtn}" Content="&gt;" Tag="vp_cogbias||+1" Click="Nudge_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

            </Grid>

            <Separator Background="#444" Margin="0,12,0,0"/>
            <TextBlock Margin="0,10,0,16" Foreground="#888" FontSize="10" TextWrapping="Wrap"
                       Text="Use Controls and Events - Control Mapper to bind buttons to actions."/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
